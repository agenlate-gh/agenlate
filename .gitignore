# Next.js build output. .next/ runs to hundreds of megabytes and is rebuilt
# from source every time, so committing it is both large and pointless.
.next/
out/
next-env.d.ts

# Vercel's local project link. Machine-specific.
.vercel

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local scratch
*.local
agents.local.json
