# Normalise line endings. You develop on Windows; Render builds on Linux.
# Without this, CRLF leaks into the repo and breaks shell scripts at deploy time.
* text=auto eol=lf

# Binary — never touch these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary

# Lockfiles are machine-generated and enormous. Marking them keeps them out of
# diffs and stops them dominating language statistics; they are still committed,
# because a build that resolves different versions than the last one is not the
# same build.
pnpm-lock.yaml    -diff linguist-generated
package-lock.json -diff linguist-generated

# Generated by Next.js on every build, but committed by convention.
next-env.d.ts     -diff linguist-generated
