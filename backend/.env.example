# ---------------------------------------------------------------------------
# Backend environment. Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase --------------------------------------------------------------------
SUPABASE_URL=                    # Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=               # Public key. Used for user-scoped requests so RLS applies.
SUPABASE_SERVICE_ROLE_KEY=       # BACKEND ONLY. Bypasses row-level security entirely.
                                 # Never expose to the frontend. Never log.
SUPABASE_JWT_SECRET=             # Verifies auth tokens issued by Supabase Auth.

# API -------------------------------------------------------------------------
API_ENV=development
API_CORS_ORIGINS=http://localhost:5173   # Comma-separated. In production this is the
                                         # deployed frontend origin only — never "*".

# OpenRouter ------------------------------------------------------------------
# NOTE: user API keys are deliberately absent from this file. Under BYOK the key
# arrives per-run from the user's browser, is held in memory for that run only,
# and is never persisted. These are app-level defaults, not credentials.
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_APP_URL=https://agenlate.ai
OPENROUTER_APP_TITLE=Agenlate

# Run limits ------------------------------------------------------------------
# Termination guarantees. A run must always stop for a named reason.
RUN_MAX_TURNS=25
RUN_SPEND_CAP_USD=1.00
RUN_STALL_REPEAT_LIMIT=3
RUN_NO_PROGRESS_LIMIT=3
# When the provider stops reporting cost, the spend cap stops protecting
# anyone. This is how many unpriced calls are tolerated before a run stops.
RUN_UNPRICED_CALL_LIMIT=10
RUN_TOOL_ROUNDS_PER_DISPATCH=5
