# ---------------------------------------------------------------------------
# Frontend environment. Copy to .env and fill in.
#
# WARNING: Vite inlines every VITE_ variable into the built JavaScript bundle at
# compile time. Anything here is PUBLIC and permanently readable by any visitor.
# The Supabase service-role key must NEVER appear in this file.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=               # Same project URL as the backend
VITE_SUPABASE_ANON_KEY=          # Public by design — safe here, RLS does the enforcing
VITE_API_BASE_URL=http://localhost:8000
