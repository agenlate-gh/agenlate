# ---------------------------------------------------------------------------
# Frontend environment. Copy to .env.local and fill in.
#
# WARNING: Next.js inlines every NEXT_PUBLIC_ variable into the JavaScript
# bundle at build time. Anything here is PUBLIC and permanently readable by any
# visitor. The Supabase service-role key must NEVER appear in this file — it
# bypasses row-level security entirely.
# ---------------------------------------------------------------------------

# Same project URL the backend uses.
NEXT_PUBLIC_SUPABASE_URL=

# Public by design. Row-level security is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the API lives. In production this is the Render service URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
