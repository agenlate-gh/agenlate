  "components": {
    "schemas": {
      "AgentIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "role": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Role"
          },
          "system_prompt": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "System Prompt"
          },
          "enabled_tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled Tools",
            "description": "Null means the defaults. An empty list means no tools."
          }
        },
        "type": "object",
        "required": [
          "name",
          "role",
          "system_prompt"
        ],
        "title": "AgentIn"
      },
      "AgentOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "system_prompt": {
            "type": "string",
            "title": "System Prompt"
          },
          "enabled_tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled Tools"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "system_prompt",
          "enabled_tools",
          "created_at",
          "updated_at"
        ],
        "title": "AgentOut"
      },
      "AgentPatch": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "system_prompt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "System Prompt"
          },
          "enabled_tools": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Enabled Tools"
          }
        },
        "type": "object",
        "title": "AgentPatch"
      },
      "BuilderMessage": {
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^(user|assistant)$",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "BuilderMessage"
      },
      "BuilderRequest": {
        "properties": {
          "api_key": {
            "type": "string",
            "format": "password",
            "title": "Api Key",
            "writeOnly": true
          },
          "conversation": {
            "items": {
              "$ref": "#/components/schemas/BuilderMessage"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Conversation"
          },
          "model": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model",
            "default": "qwen/qwen3.7-flash"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Role"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          }
        },
        "type": "object",
        "required": [
          "api_key"
        ],
        "title": "BuilderRequest"
      },
      "BuilderResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply"
          },
          "instructions": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          },
          "needs_answer": {
            "type": "boolean",
            "title": "Needs Answer"
          },
          "cost_usd": {
            "anyOf": [
