    "/api/usage/summary": {
      "get": {
        "tags": [
          "usage"
        ],
        "summary": "Usage Summary",
        "description": "Summarise this caller's usage.\n\nAggregated in Python rather than SQL: the row counts here are small \u2014 one\nper provider request per user \u2014 and a database function would be a second\nplace for the definition of \"cost\" to live and drift.",
        "operationId": "usage_summary_api_usage_summary_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "days",
